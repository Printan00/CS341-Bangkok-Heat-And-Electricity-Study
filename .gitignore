.DS_Store

# Docs: track only the proposal and its revision plan
Docs/*
!Docs/Proposal_Revision_Plan.md
!Docs/Copy of CS341_Proposal_Template.docx.pdf

# Survey data: never commit (public repo)
data/

# Terraform: never commit state, secrets, or provider cache
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log
tfplan
.build/

# Python (note: .gitignore does not stop terraform from zipping a local __pycache__)
__pycache__/
.venv/
